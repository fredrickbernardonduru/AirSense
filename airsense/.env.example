# OpenAQ — put the newly rotated key here
OPENAQ_API_KEY=

# AirSense first deployment location
DEFAULT_CITY=nairobi

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_AIR_QUALITY_TOPIC=airsense.air-quality.raw
KAFKA_WEATHER_TOPIC=airsense.weather.raw

# API behavior
REQUEST_TIMEOUT_SECONDS=30
OPENAQ_RADIUS_METERS=25000
OPENAQ_PAGE_LIMIT=100
POLL_INTERVAL_SECONDS=900
